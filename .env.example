DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3
# Docker/MySQL example: mysql://student:student_password@db:3306/student_records
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
LOOKUP_HMAC_KEY=replace-with-a-long-random-hmac-secret
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
APP_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@student-record.local
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_HMAC_SECRET=replace-with-a-payment-hmac-secret
DOCUMENT_STORAGE_PATH=var/documents
MALWARE_SCANNER=deterministic
ATTENDANCE_THRESHOLD_DEFAULT=75
OTP_TTL_MINUTES=10
ACCOUNT_LOCK_FAILED_ATTEMPTS=5
RETENTION_YEARS=10
SECURE_COOKIES=0
